MUSICBOT_HOST=127.0.0.1
MUSICBOT_PORT=8710
MUSICBOT_OUTPUT_DIR=C:\Users\Dubo\Dropbox\AI Music
MUSICBOT_TEMP_DIR=C:\Users\Dubo\Dropbox\Personal\Sustav Dev\TelegramMusicBot\.runtime\temp
MUSICBOT_HISTORY_DB=C:\Users\Dubo\Dropbox\Personal\Sustav Dev\TelegramMusicBot\.runtime\musicbot.sqlite3

# Ollama turns messy Telegram messages into a structured music brief.
OLLAMA_URL=http://127.0.0.1:11435/api/generate
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=0s
# start-ollama-1080ti.ps1 documents the matching WSL/1080 Ti server settings.

# Leave empty for the built-in short WAV plumbing test.
# Set this to your ACE-Step/ComfyUI/custom renderer command when ready.
# The command receives these environment variables:
# MUSICBOT_PROMPT_JSON, MUSICBOT_PROMPT_TEXT, MUSICBOT_OUTPUT_PATH,
# MUSICBOT_REFERENCE_PATH, MUSICBOT_DURATION_SECONDS, MUSICBOT_TITLE.
MUSIC_GENERATOR_COMMAND=
MUSIC_GENERATOR_TIMEOUT_SECONDS=14400
MUSICBOT_OUTPUT_FORMAT=mp3
MUSICBOT_DEFAULT_QUALITY=draft
MUSICBOT_DEFAULT_DURATION_SECONDS=120
MUSICBOT_MAX_DURATION_SECONDS=1800
MUSICBOT_MAX_TELEGRAM_DURATION_SECONDS=1800
MUSICBOT_DRAFT_VARIANTS=3
MUSICBOT_MAX_DRAFT_VARIANTS=4
MUSICBOT_LONG_RENDER_SECONDS=600
MUSICBOT_LONG_DRAFT_VARIANTS=1

# The fallback renderer intentionally stays short so test jobs finish quickly.
MUSICBOT_FALLBACK_TONE_SECONDS=18
MUSICBOT_FALLBACK_VARIATION=true

# ACE-Step wrapper tuning.
ACE_STEP_THINKING=true
ACE_STEP_USE_FORMAT=true
ACE_STEP_INFERENCE_STEPS=24
ACE_STEP_INFER_METHOD=ode
ACE_STEP_SAMPLER_MODE=euler
ACE_STEP_VELOCITY_NORM_THRESHOLD=2.0
ACE_STEP_MP3_BITRATE=96k
ACE_STEP_SEGMENT_LONG_AUDIO=true
ACE_STEP_MAX_SINGLE_DURATION_SECONDS=120
ACE_STEP_LONG_SEGMENT_SECONDS=120
ACE_STEP_LONG_CROSSFADE_SECONDS=3
ACE_STEP_STITCH_TIMEOUT_SECONDS=3600
ACE_STEP_LM_TEMPERATURE=0.95
ACE_STEP_LM_CFG_SCALE=2.2
ACE_STEP_LM_TOP_P=0.92
ACE_STEP_LM_REPETITION_PENALTY=1.15
ACE_STEP_REFERENCE_TASK_TYPE=cover
ACE_STEP_AUDIO_COVER_STRENGTH=0.82
ACE_STEP_COVER_NOISE_STRENGTH=0.82

# Optional direct Telegram polling mode. Leave unset if n8n owns inbound Telegram.
MUSICBOT_TELEGRAM_BOT_TOKEN=
MUSICBOT_GENERATE_URL=http://127.0.0.1:8710/generate
TELEGRAM_POLL_SECONDS=3
DUBO_CHAT_TIMEOUT_SECONDS=45
